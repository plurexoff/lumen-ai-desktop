{
  "compilerOptions": {
    "target": "ES2022", "module": "CommonJS", "moduleResolution": "Node", "outDir": "dist-cli",
    "rootDir": ".", "strict": true, "esModuleInterop": true, "skipLibCheck": true,
    "types": ["node"], "noUnusedLocals": true, "noUnusedParameters": true
